    R5{"Checklist docs complete and approved?"}
    R6["ATP_MyRep<br/>Upload punchlist / rectification files"]
    R7{"ATP done?"}
    R8["Set cluster DONE"]
    R9["Reject and request revision"]
    R10["Tables<br/>tb_rfs_myrep_claim<br/>md_rfs_myrep_doc_group/item<br/>tb_rfs_myrep_doc_package/file/log<br/>tb_rfs_myrep_atp_file"]
