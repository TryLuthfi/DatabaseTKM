    MF3{"Mainfeeder docs approved?"}
    MF4["Mainfeeder package DONE"]
    MF5["Reject and request revision"]
    MF6["Tables<br/>tb_rfs_myrep_mainfeeder<br/>md_rfs_myrep_mainfeeder_doc_group/item<br/>tb_rfs_myrep_mainfeeder_doc_package/file/log"]
  end

  subgraph PO["PO Monitoring"]
