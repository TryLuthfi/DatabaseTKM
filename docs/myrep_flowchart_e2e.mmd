    D6{"Not required approved?"}
    D7["Review BOQ file"]
    D8{"BOQ approved?"}
    D9["Create ACTIVE BOQ baseline"]
    D10["Reject and request BOQ/document revision"]
    D11["Tables<br/>tb_myrep_drm<br/>tb_myrep_scope_requirement<br/>tb_myrep_drm_boq<br/>tb_myrep_drm_boq_item<br/>tb_myrep_boq_baseline<br/>tb_myrep_boq_baseline_item"]
  end

  subgraph IMPL["Implementation BOQ"]
    I1["Implementasi_BOQ_MyRep<br/>Record daily activity"]
    I2["Upload daily activity photos"]
    I3["Input BOQ progress item"]
    I4["Upload comply photos"]
    I5{"Daily / comply approved?"}
    I6["Progress accepted"]
    I7["Reject photo/progress and revise"]
    I8["Tables<br/>tb_myrep_impl_daily_activity<br/>tb_myrep_impl_daily_activity_photo<br/>tb_myrep_boq_progress_item<br/>tb_myrep_boq_progress_photo"]
  end

  subgraph RFS["RFS, Checklist, ATP"]
    R1["Monitoring_RFS_MyRep<br/>Submit RFS claim"]
    R2{"RPM/HO claim approved?"}
    R3["Checklist_Dokument_MyRep<br/>Create cluster document package"]
